# Copy these names into /etc/cordia/cordia.env or your deployment secret store.
# Do not commit the real values.
CORDIA_PG_DSN=postgresql://user:password@host:5432/cordia
CORDIA_VAULT_KEY=generate-with-cryptography-fernet

# Production needs SMTP-backed email 2FA. CORDIA_DEV_2FA=1 is local development only.
GMAIL_USER=ops@example.com
GMAIL_APP_PASSWORD=generate-a-gmail-app-password

# Optional: defaults to 127.0.0.1 for the existing reverse-proxy deployment.
CORDIA_BIND=127.0.0.1
# Keep downloaded embedding models inside the service's writable data boundary.
HF_HOME=/var/lib/cordia/huggingface
# Localhost preview only. Production must retain the secure-cookie default.
# CORDIA_COOKIE_SECURE=0
